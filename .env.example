# Copy to .env.local for local dev, or add these in Vercel > Project > Settings >
# Environment Variables. Never commit real keys.
#
# The /demo works with every value empty: bills are then read by offline OCR
# (Tesseract.js in the browser for photos, the text layer for PDFs) and the rate
# limit is kept in memory.

# --- AI extraction -------------------------------------------------------------
# Fallback order: GEMINI_MODEL -> GEMINI_FALLBACK_MODEL (only on 429 / quota
# errors) -> offline OCR.
# "gemini" (default) or "claude" (stub, not implemented yet).
AI_PROVIDER=gemini
# Free key from https://aistudio.google.com/apikey. Server-only, never sent to the browser.
GEMINI_API_KEY=
# Primary model, e.g. a Flash-Lite model from your AI Studio quota page.
GEMINI_MODEL=
# Used only when GEMINI_MODEL returns 429 / quota exhausted. Optional.
GEMINI_FALLBACK_MODEL=

# Claude provider (stubbed for later; not used by the demo).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Rate limit (5 demo runs per hour per IP) ------------------------------------
# Required on Vercel for a real limit: each serverless instance has its own
# memory. Create a free Redis database at https://console.upstash.com and copy its
# REST URL and token. If either is empty, the limit falls back to in-memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Database (not used yet) ------------------------------------------------------
# For the Prisma data model planned in Phase 2. The demo and the build don't need
# it; leave it unset on Vercel.
DATABASE_URL="file:./dev.db"
