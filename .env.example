# Copy to .env.local and fill in. Never commit real keys.
# AI extraction. Fallback order: GEMINI_MODEL -> GEMINI_FALLBACK_MODEL
# (on 429 / quota errors) -> offline OCR.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
DATABASE_URL="file:./dev.db"
